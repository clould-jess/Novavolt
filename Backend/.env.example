NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://user:password@your-neon-pooler-host/neondb?sslmode=require&pgbouncer=true&connection_limit=1
DIRECT_URL=postgresql://user:password@your-neon-direct-host/neondb?sslmode=require

# Generate two independent values, each at least 64 random characters.
JWT_ACCESS_SECRET=replace-this-development-access-secret-with-at-least-64-random-characters
JWT_REFRESH_SECRET=replace-this-development-refresh-secret-with-another-64-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=novavolt-api
JWT_AUDIENCE=novavolt-clients
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
MAX_ACTIVE_SESSIONS=10

CORS_ORIGINS=https://locationnovavolt.ca
APP_URL=https://locationnovavolt.ca
ENABLE_SWAGGER=true
REQUIRE_EMAIL_VERIFICATION=true
EXPOSE_DEVELOPMENT_TOKENS=true

# Default admin account created on backend start. Keep this unique and private.
DEFAULT_ADMIN_EMAIL=admin@novavolt.local
DEFAULT_ADMIN_PASSWORD=ChangeThisDefaultAdminPass1!
DEFAULT_ADMIN_FIRST_NAME=Admin
DEFAULT_ADMIN_LAST_NAME=Novavolt
ADMIN_EMAIL=mbafokou2@gmail.com

# Signed delivery webhook used by your email/SMS provider adapter.
NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
RESEND_FROM_EMAIL=Novavolt <onboarding@resend.dev>
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# Generate with: openssl rand -hex 32
NOTIFICATION_PAYLOAD_ENCRYPTION_KEY=

# Stripe remains fail-closed until both secrets are configured.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Private S3-compatible bucket. Use only a real cloud bucket in production.
DOCUMENT_UPLOADS_ENABLED=true
MALWARE_SCAN_REQUIRED=false
MALWARE_SCANNER_WEBHOOK_SECRET=
OBJECT_STORAGE_BUCKET=novavolt-private
OBJECT_STORAGE_REGION=ca-central-1
OBJECT_STORAGE_ENDPOINT=https://your-object-storage-endpoint
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-production-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-production-secret

# Vehicle photos use ImageKit. Keep documents on the private object storage above.
IMAGEKIT_PUBLIC_KEY=public_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your-account
IMAGEKIT_VEHICLES_FOLDER=vehicle

# One-time owner bootstrap. Never commit real values.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_FIRST_NAME=
SEED_OWNER_LAST_NAME=
ALLOW_PRODUCTION_SEED=false
