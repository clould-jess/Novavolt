NODE_ENV=development
PORT=4000
TRUST_PROXY_HOPS=0

DATABASE_URL=postgresql://novavolt:change_me@localhost:5432/novavolt?schema=public

# Generate two independent values, each at least 64 random characters.
JWT_ACCESS_SECRET=replace-this-development-access-secret-with-at-least-64-random-characters
JWT_REFRESH_SECRET=replace-this-development-refresh-secret-with-another-64-random-characters
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_ISSUER=novavolt-api
JWT_AUDIENCE=novavolt-clients
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
MAX_ACTIVE_SESSIONS=10

CORS_ORIGINS=http://localhost:3000
APP_URL=http://localhost:3000
ENABLE_SWAGGER=true
REQUIRE_EMAIL_VERIFICATION=false
EXPOSE_DEVELOPMENT_TOKENS=true

# Signed delivery webhook used by your email/SMS provider adapter.
NOTIFICATIONS_ENABLED=false
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# Generate with: openssl rand -hex 32
NOTIFICATION_PAYLOAD_ENCRYPTION_KEY=

# Stripe remains fail-closed until both secrets are configured.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Private S3-compatible bucket. IAM/instance credentials are preferred in production.
DOCUMENT_UPLOADS_ENABLED=false
MALWARE_SCAN_REQUIRED=false
MALWARE_SCANNER_WEBHOOK_SECRET=
OBJECT_STORAGE_BUCKET=novavolt-private
OBJECT_STORAGE_REGION=ca-central-1
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_FORCE_PATH_STYLE=false
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# One-time owner bootstrap. Never commit real values.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_FIRST_NAME=
SEED_OWNER_LAST_NAME=
ALLOW_PRODUCTION_SEED=false
